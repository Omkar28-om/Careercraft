# =============================================================================
# CAREERCRAFT BACKEND ENVIRONMENT CONFIGURATION (PRODUCTION TEMPLATE)
# =============================================================================
# Copy this file to .env and provide your deployment-specific values.
# NEVER commit real credentials, database passwords, or secret keys to Git.
# =============================================================================

# 1. CORE SERVER CONFIGURATION
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# 2. CORS & FRONTEND CLIENT ORIGIN
# -----------------------------------------------------------------------------
# Primary frontend URL. In production, this MUST use HTTPS.
CLIENT_URL=https://careercraft.example.com

# Additional allowed origins (comma-separated). In production, all must use HTTPS.
# Example: https://app.careercraft.com,https://preview.careercraft.com
CORS_ORIGINS=

# 3. POSTGRESQL DATABASE
# -----------------------------------------------------------------------------
# Full PostgreSQL connection URI.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/careercraft?sslmode=require

# 4. JWT AUTHENTICATION
# -----------------------------------------------------------------------------
# Secret key used for signing session tokens.
# MUST be a cryptographically secure random string of AT LEAST 32 characters.
# Generate via: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters

# 5. JUDGE0 REMOTE CODE EXECUTION (OPTIONAL / CODING PLATFORM)
# -----------------------------------------------------------------------------
# Base URL of your Judge0 CE instance.
# Public endpoint: https://ce.judge0.com
JUDGE0_BASE_URL=https://ce.judge0.com

# Judge0 API Key (leave blank if self-hosted or using unauthenticated instance)
JUDGE0_API_KEY=
JUDGE0_POLL_INTERVAL_MS=1000
JUDGE0_MAX_POLL_ATTEMPTS=15

# 6. AI CAREER RECOMMENDATIONS (OPTIONAL)
# -----------------------------------------------------------------------------
# Set to 'true' to enable AI-powered career pathway explanations.
# If disabled or if keys are missing, the system automatically uses
# high-conviction deterministic competency synthesis.
ENABLE_AI_CAREER_PROVIDER=false
GEMINI_API_KEY=
OPENAI_API_KEY=
